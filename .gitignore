# Go
/core/bin/
/cli/bin/
/dist/
/knotd
/knotctl
*.exe
*.test
*.out

# UI
/ui/node_modules/
/ui/.svelte-kit/
/ui/build/
/ui/.vite/

# Image build artifacts
/image/deploy/
/image/work/
/image/cache/
/image/pi-gen/

# Defensive: cmd.exe sometimes interprets `>` inside echoed strings as
# redirect operators, dropping zero-byte files into the cwd. Block the
# specific names that have appeared in past runs so they never get
# committed again.
/image/Building
/image/Installing
/image/Starting
/image/knot-ui@*
/image/stage-knot/00-install-knotd/files/knotd
/image/stage-knot/00-install-knotd/files/knotctl
/image/stage-knot/01-install-plugins/files/example-hello/
/image/stage-knot/01-install-plugins/files/*/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Local dev state
/tmp/
*.log

# Local tooling state
.claude/
/dist/

# Embedded UI artifacts — regenerated by scripts/build-ui.sh before `go build`.
/core/internal/web/dist/*
!/core/internal/web/dist/.gitkeep
